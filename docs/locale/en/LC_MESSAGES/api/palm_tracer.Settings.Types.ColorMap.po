msgstr "Accessors"

#: of palm_tracer.Settings.Types.ColorMap.ColorMap.get_ui:1
msgid "Renvoie une interface existante ou crée une liste déroulante avec les aperçus."
msgstr "Returns an existing interface or creates a drop-down list with previews."

#: of palm_tracer.Settings.Types.ColorMap.ColorMap.get_ui:3
msgid "Nom de l'interface dans le dictionnaire."
msgstr "Interface name in the dictionary."

#: ../../api/palm_tracer.Settings.Types.ColorMap.rst
msgid "Renvoie"
msgstr "Returns"

#: of palm_tracer.Settings.Types.ColorMap.ColorMap.get_ui:4
msgid "Interface du paramètre."
msgstr "Parameter interface."

