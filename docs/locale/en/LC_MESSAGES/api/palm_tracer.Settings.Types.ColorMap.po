#: ../../api/palm_tracer.Settings.Types.ColorMap.rst:2
msgid "ColorMap"
msgstr ""

#: of palm_tracer.Settings.Types.ColorMap.ColorMap:1
msgid "Représente une colormap sélectionnée dans une liste déroulante avec aperçu."
msgstr "Represents a colormap selected from a drop-down list with a preview."

#: of palm_tracer.Settings.Types.ColorMap.ColorMap:3
msgid "La liste proposée par défaut centralise les colormaps utilisées par PALM Tracer. Chaque entrée valide pour Matplotlib est accompagnée d'une icône représentant son dégradé."
msgstr "The default list centralizes the colormaps used by PALM Tracer. Each entry recognized by Matplotlib includes an icon representing its gradient."

#: ../../api/palm_tracer.Settings.Types.ColorMap.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.Settings.Types.ColorMap.ColorMap:6
msgid "Libellé affiché dans l'interface."
msgstr "Label displayed in the interface."

#: of palm_tracer.Settings.Types.ColorMap.ColorMap:7
msgid "Description affichée dans l'infobulle."
msgstr "Description displayed in the tooltip."

#: of palm_tracer.Settings.Types.ColorMap.ColorMap:8
msgid "Indice sélectionné par défaut."
msgstr "Default selected index."

#: of palm_tracer.Settings.Types.ColorMap.ColorMap:9
msgid "Noms des colormaps proposées."
msgstr "Names of the available colormaps."

#: ../../api/palm_tracer.Settings.Types.ColorMap.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.Settings.Types.ColorMap.ColorMap.AVAILABLE_MAPS:1
msgid "Colormaps proposées par défaut."
msgstr "Colormaps available by default."

#: ../../../docstring of
#: palm_tracer.Settings.Types.ColorMap.ColorMap.ICON_SIZE:1
msgid "Dimensions de l'aperçu affiché dans la liste."
msgstr "Dimensions of the preview displayed in the list."

#: ../../../docstring of
#: palm_tracer.Settings.Types.ColorMap.ColorMap.PICKER_ICON_SIZE:1
msgid "Dimensions de l'aperçu affiché sur le bouton du sélecteur de couleur."
msgstr "Dimensions of the preview displayed on the color picker button."

#: of palm_tracer.Settings.Types.ColorMap.ColorMap.GRADIENT_STOPS:1
msgid "Nombre de couleurs échantillonnées pour dessiner un aperçu."
msgstr "Number of sampled colors used to draw a preview."

#: of palm_tracer.Settings.Types.ColorMap.ColorMap.CUSTOM_LABEL:1
msgid "Préfixe de l'entrée temporaire créée par le sélecteur de couleur."
msgstr "Prefix of the temporary entry created by the color picker."

#: of palm_tracer.Settings.Types.ColorMap.ColorMap.items:1
msgid "Récupère la liste des éléments."
msgstr "Returns the list of items."

