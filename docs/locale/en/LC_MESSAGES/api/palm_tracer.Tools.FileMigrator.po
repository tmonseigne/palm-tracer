msgstr "Returns the DataFrame reordered according to ``target_cols``."

#: of palm_tracer.Tools.FileMigrator.FileMigrator.dataframe_migrator:9
msgid "DataFrame d'entrée issue du format PALMTracer."
msgstr "Input DataFrame from the PALMTracer format."

#: of palm_tracer.Tools.FileMigrator.FileMigrator.dataframe_migrator:10
msgid "Liste ordonnée des colonnes attendues dans le format cible."
msgstr "Ordered list of columns expected in the target format."

#: of palm_tracer.Tools.FileMigrator.FileMigrator.dataframe_migrator:11
