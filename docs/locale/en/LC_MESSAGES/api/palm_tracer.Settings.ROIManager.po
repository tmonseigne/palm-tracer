msgstr ""

#: of palm_tracer.Settings.ROIManager.ROIManager.update_colors:1
msgid "Met à jour les couleurs selon la sélection courante."
msgstr "Updates the colors based on the current selection."

#: of palm_tracer.Settings.ROIManager.ROIManager.get_roi_limits:1
msgid "Définit la bounding box de la zone d'intérêt (utile pour la génération HR)."
msgstr "Sets the bounding box for the region of interest (useful for HR generation)."

#: ../../api/palm_tracer.Settings.ROIManager.rst
msgid "Renvoie"
msgstr "Returns"

#: of palm_tracer.Settings.ROIManager.ROIManager.get_roi_limits:3
msgid "Positions x_min, x_max, y_min, y_max."
msgstr "Positions x_min, x_max, y_min, y_max."

#: ../../api/palm_tracer.Settings.ROIManager.rst
msgid "Type renvoyé"
msgstr "Return type"

#: of palm_tracer.Settings.ROIManager.ROIManager.update_hr_box:1
msgid "Mets à jour la bounding box actuelle de la génération Haute résolution."
msgstr "Updates the current bounding box for high-resolution generation."

#: of palm_tracer.Settings.ROIManager.ROIManager.filtering_dataframe:1
msgid "Filtre un DataFrame selon la ROI sélectionnée."
msgstr "Filters a DataFrame based on the selected ROI."

#: of palm_tracer.Settings.ROIManager.ROIManager.filtering_dataframe:3
msgid "Un premier filtrage rapide est effectué à partir de la bounding box. Si ``strict`` vaut ``True``, les points sont ensuite filtrés selon la géométrie exacte de la ROI."
msgstr "An initial quick filter is applied using the bounding box. If ``strict`` is ``True``, the points are then filtered based on the exact geometry of the ROI."

#: of palm_tracer.Settings.ROIManager.ROIManager.filtering_dataframe:6
msgid "DataFrame contenant les colonnes ``X`` et ``Y``."
msgstr "DataFrame containing the ``X`` and ``Y`` columns."

#: of palm_tracer.Settings.ROIManager.ROIManager.filtering_dataframe:7
msgid "Filtre selon la forme exacte et non uniquement selon la bounding box."
msgstr "Filters based on the exact shape, not just the bounding box."

#: of palm_tracer.Settings.ROIManager.ROIManager.filtering_dataframe:8
msgid "Copie filtrée du DataFrame."
msgstr "Filtered copy of the DataFrame."
