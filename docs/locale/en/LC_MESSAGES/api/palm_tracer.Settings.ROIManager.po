msgid "Synchronization"
msgstr ""

#: of palm_tracer.Settings.ROIManager.ROIManager.update_from_main:1
msgid "Mets à jour la liste des ROI à partir du calque principal (callback appelé à chaque modification dans le calque principal)."
msgstr "Update the ROI list from the main layer (callback called whenever a change is made to the main layer)."

#: of palm_tracer.Settings.ROIManager.ROIManager.update_from_hr:1
msgid "Mets à jour la liste des ROI à partir du calque haute résolution (callback appelé à chaque modification dans le calque haute résolution)."
msgstr "Update the ROI list from the high-resolution layer (callback called whenever a change is made to the high-resolution layer)."

#: of palm_tracer.Settings.ROIManager.ROIManager.update_main:1
msgid "Mets à jour le calque principal."
msgstr "Update the main layer."

#: of palm_tracer.Settings.ROIManager.ROIManager.update_hr:1
msgid "Mets à jour le calque Haute Résolution."
msgstr "Update the high resoultion layer."

#: of palm_tracer.Settings.ROIManager.ROIManager.update_hr:3
msgid "Les zones d'intérêts doivent être adaptées au ratio d'agrandissement et aux dimensions maximales de l'image."
msgstr "The areas of interest must be adjusted to the magnification ratio and the maximum dimensions of the image."

#: of palm_tracer.Settings.ROIManager.ROIManager.on_hr_selection_changed:1
#: palm_tracer.Settings.ROIManager.ROIManager.on_main_selection_changed:1
msgid "Traite un changement de sélection."
msgstr "Handles a change in selection."

#: of palm_tracer.Settings.ROIManager.ROIManager.on_hr_selection_changed:3
#: palm_tracer.Settings.ROIManager.ROIManager.on_main_selection_changed:3
msgid "Événement napari associé au changement."
msgstr "A Napari event associated with change."

