#: of palm_tracer.Settings.ROIManager.ROIManager.set_size:1
msgid "Mets à jour la hauteur et largeur maximale de la ROI."
msgstr "Update the maximum height and width of the ROI."

#: of palm_tracer.Settings.ROIManager.ROIManager.set_size:3
msgid "Largeur en pixel."
msgstr "Width in pixels."

#: of palm_tracer.Settings.ROIManager.ROIManager.set_size:4
msgid "Hauteur en pixel."
msgstr "Height in pixels."

#: of palm_tracer.Settings.ROIManager.ROIManager.set_xy_roi:1
msgid "Ajoute une zone d'intérêt type rectangle pour un filtre rapide sur X et Y (utile pour simplifier le filtre par ROI en script)."
msgstr "Adds a rectangular region of interest for quick filtering along the X and Y axes (useful for simplifying ROI filtering in scripts)."

#: of palm_tracer.Settings.ROIManager.ROIManager.set_xy_roi:3
msgid "Position minimale sur X."
msgstr "Minimum position on X."

#: of palm_tracer.Settings.ROIManager.ROIManager.set_xy_roi:4
msgid "Position maximale sur X."
msgstr "Maximum position on X."

#: of palm_tracer.Settings.ROIManager.ROIManager.set_xy_roi:5
msgid "Position minimale sur Y."
msgstr "Minimum position on Y."

#: of palm_tracer.Settings.ROIManager.ROIManager.set_xy_roi:6
msgid "Position maximale sur Y."
msgstr "Maximum position on Y."

#: of palm_tracer.Settings.ROIManager.ROIManager.set_xy_roi:7
msgid "Ajoute la zone aux zones éxistantes si ``True``, sinon remplace les zones par la nouvelle."
msgstr "Adds the region to existing regions if ``True``, otherwise replaces the regions with the new one."

