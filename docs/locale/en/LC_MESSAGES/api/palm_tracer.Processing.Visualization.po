msgid "Type renvoyé"
msgstr "Return type"

#: of palm_tracer.Processing.Visualization.get_bins_number:1
msgid "Calcule un nombre de bin adaptatif pour un histogramme."
msgstr "Calculates an adaptive number of bins for a histogram."

#: of palm_tracer.Processing.Visualization.get_bins_number:3
msgid "Données à analyser."
msgstr "Data to be analyzed."

#: of palm_tracer.Processing.Visualization.get_bins_number:4
msgid "Bornes pour le nombre de bins."
msgstr "Bounds for the number of bins."

#: of palm_tracer.Processing.Visualization.get_bins_number:5
msgid "Nombre de bins."
msgstr "Number of bins."

#: of palm_tracer.Processing.Visualization.render_hr_image:1
msgid "Construit une image Haute résolution en fonction des éléments localisés."
msgstr "Constructs a high-resolution image based on the localized elements."

#: of palm_tracer.Processing.Visualization.render_hr_image:3
msgid "Largeur de l'image."
msgstr "Image width."

#: of palm_tracer.Processing.Visualization.render_hr_image:4
msgid "Hauteur de l'image."
msgstr "Image height."

#: of palm_tracer.Processing.Visualization.render_hr_image:5
msgid "Ratio d'agrandissement de l'image."
msgstr "Image magnification ratio."

#: of palm_tracer.Processing.Visualization.render_hr_image:6
msgid "Localisations des points."
msgstr "Point localizations."

#: of palm_tracer.Processing.Visualization.render_hr_image:7
msgid "Normalisation des valeurs (pour les mettre entre `0` et `SCALE`)."
msgstr "Normalization of values (to place them between `0` and `SCALE`)."

#: of palm_tracer.Processing.Visualization.render_hr_image:8
#: palm_tracer.Processing.Visualization.render_tracks_image:14
msgid "Nouvelle image en uint16 de forme (height*ratio, width*ratio)."
msgstr "New image in uint16 format (height*ratio, width*ratio)."

#: of palm_tracer.Processing.Visualization.render_tracks_image:1
msgid "Construit une image haute résolution (uint16) à partir de trajectoires localisées. Chaque trajectoire est tracée par segments (P0→P1, P1→P2, …) avec une couleur unique."
msgstr "Constructs a high-resolution image (uint16) from localized tracks. Each track is drawn in segments (P0→P1, P1→P2, …) with a unique color."

#: of palm_tracer.Processing.Visualization.render_tracks_image:4
msgid "Colonnes attendues dans `tracks` :"
msgstr "Expected columns in `tracks`:"

#: of palm_tracer.Processing.Visualization.render_tracks_image:5
msgid "\"Track\" : identifiant de la trajectoire (:class:`int`)"
msgstr "\"Track\": track identifier (:class:`int`)"

#: of palm_tracer.Processing.Visualization.render_tracks_image:6
msgid "\"Plane\" : ordre/plan (:class:`int`) ; uniquement utilisé pour trier temporellement"
msgstr "\"Plane\": order/plane (:class:`int`); used only for temporal sorting"

#: of palm_tracer.Processing.Visualization.render_tracks_image:7
msgid "\"X\", \"Y\" : coordonnées (:class:`float`, en pixels dans l'image de base)"
msgstr "\"X\", \"Y\": coordinates (:class:`float`, in pixels in the base image)"

#: of palm_tracer.Processing.Visualization.render_tracks_image:8
msgid "\"Color\" : intensité à tracer ``(0..65535)``. Toute valeur hors bornes est tronquée."
msgstr "\"Color\": intensity to plot ``(0..65535)``. Any out-of-range value is truncated."

#: of palm_tracer.Processing.Visualization.render_tracks_image:10
msgid "Largeur de l'image de base."
msgstr "Width of the base image."

#: of palm_tracer.Processing.Visualization.render_tracks_image:11
msgid "Hauteur de l'image de base."
msgstr "Height of the base image."

#: of palm_tracer.Processing.Visualization.render_tracks_image:12
msgid "Ratio d'agrandissement de l'image (>=1). Les coordonnées sont multipliées par ce facteur."
msgstr "Image magnification ratio (>=1). The coordinates are multiplied by this factor."

#: of palm_tracer.Processing.Visualization.render_tracks_image:13
msgid "Tableau des points de trajectoires."
msgstr "Array of tracks points."

#: of palm_tracer.Processing.Visualization.render_roi:1
msgid "Construit une image RGB à partir d'une image en niveaux de gris et ajoute les contours des zones d'intérêts autour des points donnés."
msgstr "Constructs an RGB image from a grayscale image and adds the outlines of regions of interest around the given points."

#: of palm_tracer.Processing.Visualization.render_roi:3
msgid "Image d'entrée en niveaux de gris (numpy array 2D)."
msgstr "Grayscale input image (2D numpy array)."

#: of palm_tracer.Processing.Visualization.render_roi:4
msgid "Tableau 2D des coordonnées (X, Y) des points, sous forme de flottants."
msgstr "2D array of point coordinates (X, Y) as floats."

#: of palm_tracer.Processing.Visualization.render_roi:5
msgid "Taille du carré à dessiner autour de chaque point."
msgstr "Size of the square to draw around each point."

#: of palm_tracer.Processing.Visualization.render_roi:6
msgid "Couleur du contour du ROI en RGB (tuple ou liste de trois valeurs)."
msgstr "ROI outline color in RGB (tuple or list of three values)."

#: of palm_tracer.Processing.Visualization.render_roi:7
msgid "Image RGB avec les contours des zones d'intérêts dessinés."
msgstr "RGB image with the outlines of the regions of interest drawn."

#: of palm_tracer.Processing.Visualization.plot_histogram:1
msgid "Trace un histogramme des données avec Seaborn, et optionnellement une courbe kernel density estimation."
msgstr "Plots a histogram of the data using Seaborn, and optionally a kernel density estimation curve."

#: of palm_tracer.Processing.Visualization.plot_histogram:3
#: palm_tracer.Processing.Visualization.plot_plane_violin:3
msgid "Axe sur lequel tracer l'histogramme."
msgstr "Axis on which to plot the histogram."

#: of palm_tracer.Processing.Visualization.plot_histogram:4
msgid "Données sous forme de tableau numpy."
msgstr "Data in the form of a NumPy array."

#: of palm_tracer.Processing.Visualization.plot_histogram:5
msgid "Titre de l'histogramme."
msgstr "Title of the histogram."

#: of palm_tracer.Processing.Visualization.plot_histogram:6
msgid "Si True, applique la règle des 3 sigmas pour limiter les données."
msgstr "If True, applies the 3-sigma rule to clip the data."

#: of palm_tracer.Processing.Visualization.plot_histogram:7
msgid "Si True, superpose une kde gaussienne."
msgstr "If True, overlays a Gaussian KDE."

#: of palm_tracer.Processing.Visualization.plot_histogram:8
msgid "Si True, normalise l'histogramme pour afficher une densité de probabilité."
msgstr "If True, normalizes the histogram to display a probability density."

#: of palm_tracer.Processing.Visualization.plot_plane_violin:1
msgid "Trace un graphique type violon pour les données en entrée ."
msgstr "Plots a violin plot for the input data."

#: of palm_tracer.Processing.Visualization.plot_plane_violin:4
msgid "Données à tracer sous forme de tableau numpy."
msgstr "Data to plot as a NumPy array."

#: of palm_tracer.Processing.Visualization.plot_plane_heatmap:5
#: palm_tracer.Processing.Visualization.plot_plane_violin:5
msgid "Titre du graphique."
msgstr "Graph title."

#: of palm_tracer.Processing.Visualization.plot_plane_heatmap:1
msgid "Trace une heatmap montrant la densité des valeurs par plan."
msgstr "Plots a heatmap showing the density of values by plane."

#: of palm_tracer.Processing.Visualization.plot_plane_heatmap:3
msgid "Axe sur lequel tracer la heatmap."
msgstr "Axis on which to plot the heatmap."

#: of palm_tracer.Processing.Visualization.plot_plane_heatmap:4
msgid "Données sous forme de tableau numpy. La première colonne représente les plans, la deuxième, les valeurs."
msgstr "Data as a NumPy array. The first column represents the planes, the second the values."

#: of palm_tracer.Processing.Visualization.plot_plane_heatmap:6
msgid "Color Map utilisé pour tracer la heatmap (`liste des colormaps <https://matplotlib.org/stable/tutorials/colors/colormaps.html>`_)."
msgstr "Color map used to generate the heatmap (`list of color maps <https://matplotlib.org/stable/tutorials/colors/colormaps.html>`_)."
