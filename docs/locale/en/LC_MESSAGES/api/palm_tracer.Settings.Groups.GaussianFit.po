#: of palm_tracer.Settings.Groups.GaussianFit.GaussianFit.toggle_fit_mode:1
msgid "Masque et désactive l'estimation axiale lorsque les deux sigmas ne sont pas ajustés séparément."
msgstr "Hides and disables axial estimation when the two sigmas are not fitted separately."

#: of palm_tracer.Settings.Groups.GaussianFit.GaussianFit.toggle_fit_mode:3
msgid "Indice du mode d'ajustement gaussien sélectionné."
msgstr "Index of the selected Gaussian fitting mode."

#: of palm_tracer.Settings.Groups.GaussianFit.GaussianFit.toggle_z_estimate:1
msgid "Affiche ou masque les paramètres de l'estimation axiale."
msgstr "Shows or hides the axial estimation settings."

#: of palm_tracer.Settings.Groups.GaussianFit.GaussianFit.toggle_z_estimate:3
msgid "Active l'affichage lorsque l'estimation de Z est sélectionnée."
msgstr "Enables display when Z estimation is selected."

