msgstr "Miscellaneous"

#: of palm_tracer.Settings.Groups.Graph.Graph.initialize:1
msgid "Initialise les connexions entre les paramètres."
msgstr "Initializes the settings dictionary."

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:1
msgid "Retourne une interface (:class:`~palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup`) existante ou en crée une si nécessaire."
msgstr "Returns an existing (:class:`~palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup`) object, or creates one if necessary."

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:3
msgid "Nom de l'interface dans le dictionnaire."
msgstr "Interface name in the dictionary."

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:4
msgid "Méthode de création du groupe.  - -1 : Valeur par défaut du groupe - 0 : Avec un titre et une checkbox pour activer/désactiver le groupe - 1 : Groupe toujours actif, sans case à cocher - 2 : Groupe sans en-tête"
msgstr "Group creation method.  - -1: Default group value - 0: With a title and a checkbox to enable or disable the group - 1: Always-active group without a checkbox - 2: Group without a header"

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:4
msgid "Méthode de création du groupe."
msgstr "Group creation method."

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:6
msgid "-1 : Valeur par défaut du groupe"
msgstr "-1: Group default value"

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:7
msgid "0 : Avec un titre et une checkbox pour activer/désactiver le groupe"
msgstr "0: With a title and a checkbox to enable/disable the group"

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:8
msgid "1 : Groupe toujours actif, sans case à cocher"
msgstr "1: Always-active group without a checkbox"

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:9
msgid "2 : Groupe sans en-tête"
msgstr "2: Group without a header"

#: ../../api/palm_tracer.Settings.Groups.Graph.rst
msgid "Renvoie"
msgstr "Returns"

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:11
msgid "Interface du groupe (:class:`~palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup`)."
msgstr "Group interface (:class:`~palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup`)."

#: ../../api/palm_tracer.Settings.Groups.Graph.rst
msgid "Type renvoyé"
msgstr "Return type"

#: of palm_tracer.Settings.Groups.Graph.Graph.toggle_type:1
msgid "Change la liste des sources pour les graphiques."
msgstr "Changes the list of sources for the graphs."

#: of palm_tracer.Settings.Groups.Graph.Graph.toggle_src:1
msgid "Affiche ou masque l'option msd step à chaque changement de source."
msgstr "Shows or hides the MSD step option with each source change."

#: of palm_tracer.Settings.Groups.Graph.Graph.toggle_mode:1
msgid "Adapte les sources et les options d'affichage au mode sélectionné. Les limites sont activées en histogramme et Dual Source, désactivées en Scatter."
msgstr "Adapts the sources and display options to the selected mode. Limits are enabled in Histogram and Dual Source modes, and disabled in Scatter mode."

#: of palm_tracer.Settings.Groups.Graph.Graph.toggle_mode:4
msgid "Mode sélectionné : ``0`` pour l'histogramme, ``1`` pour le Scatter et ``2`` pour le Dual Source."
msgstr "Selected mode: ``0`` for Histogram, ``1`` for Scatter, and ``2`` for Dual Source."
