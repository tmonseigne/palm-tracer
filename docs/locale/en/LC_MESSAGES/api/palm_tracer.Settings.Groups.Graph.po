#: of palm_tracer.Settings.Groups.Graph.Graph.initialize:1
msgid "Initialise les connexions entre les paramètres."
msgstr "Initializes the settings dictionary."

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:1
msgid "Retourne une interface (:class:`~palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup`) existante ou en crée une si nécessaire."
msgstr "Returns an existing (:class:`~palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup`) object, or creates one if necessary."

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:3
msgid "Nom de l'interface dans le dictionnaire."
msgstr "Interface name in the dictionary."

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:4
msgid "Méthode de création du groupe.  - -1 : Valeur par défaut du groupe - 0 : Avec un titre et une checkbox pour activer/désactiver le groupe - 1 : État lorsque l'on utilise la méthode always actif (la check box n'est pas créé) - 2 : État remove header (aucune création de l'espace titre)"
msgstr "Group creation method.  - -1: Default group value - 0: With a title and a checkbox to enable or disable the group - 1: State used by the always-active method (the checkbox is not created) - 2: Remove-header state (no title area is created)"

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:4
msgid "Méthode de création du groupe."
msgstr "Group creation method."

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:6
msgid "-1 : Valeur par défaut du groupe"
msgstr "-1: Group default value"

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:7
msgid "0 : Avec un titre et une checkbox pour activer/désactiver le groupe"
msgstr "0: With a title and a checkbox to enable/disable the group"

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:8
msgid "1 : État lorsque l'on utilise la méthode always actif (la check box n'est pas créé)"
msgstr "1: State when using the \"always active\" method (the checkbox is not created)"

#: of palm_tracer.Settings.Groups.Graph.Graph.get_ui:9
msgid "2 : État remove header (aucune création de l'espace titre)"
msgstr "2: \"Remove header\" state (no title area created)"

