#: ../../api/palm_tracer.Settings.Groups.Graph.rst:2
msgid "Graph"
msgstr ""

#: of palm_tracer.Settings.Groups.Graph.Graph:1
msgid "Regroupe les paramètres de sélection des graphiques."
msgstr "Groups the graph-selection settings."

#: of palm_tracer.Settings.Groups.Graph.Graph:3
msgid "Paramètres regroupés :"
msgstr "Parameters"

#: of palm_tracer.Settings.Groups.Graph.Graph:5
msgid "``Mode`` (:class:`~palm_tracer.Settings.Types.ButtonGroup.ButtonGroup`) : mode de représentation, histogramme, courbes Scatter ou nuage de points utilisant deux sources."
msgstr "``Mode`` (:class:`~palm_tracer.Settings.Types.ButtonGroup.ButtonGroup`): plot mode, histogram, Scatter curves, or a scatter plot using two sources."

#: of palm_tracer.Settings.Groups.Graph.Graph:7
msgid "``Type`` (:class:`~palm_tracer.Settings.Types.ButtonGroup.ButtonGroup`) : famille de données, localisations ou trajectoires."
msgstr "``Type`` (:class:`~palm_tracer.Settings.Types.ButtonGroup.ButtonGroup`): data family, localizations or tracks."

#: of palm_tracer.Settings.Groups.Graph.Graph:8
msgid "``Source`` (:class:`~palm_tracer.Settings.Types.Combo.Combo`) : première grandeur représentée."
msgstr "``Source`` (:class:`~palm_tracer.Settings.Types.Combo.Combo`): first quantity to display."

#: of palm_tracer.Settings.Groups.Graph.Graph:9
msgid "``Source B`` (:class:`~palm_tracer.Settings.Types.Combo.Combo`) : seconde grandeur représentée lorsque le mode ``Dual`` est actif."
msgstr "``Source B`` (:class:`~palm_tracer.Settings.Types.Combo.Combo`): second quantity to display when ``Dual`` mode is active."

#: of palm_tracer.Settings.Groups.Graph.Graph:10
msgid "``MSD Step`` (:class:`~palm_tracer.Settings.Types.SpinInt.SpinInt`) : décalage temporel sélectionné pour le MSD."
msgstr "``MSD Step`` (:class:`~palm_tracer.Settings.Types.SpinInt.SpinInt`): time lag selected for the MSD."

#: of palm_tracer.Settings.Groups.Graph.Graph:11
msgid "``Display`` (:class:`~palm_tracer.Settings.Groups.GraphDisplay.GraphDisplay`) : options de rendu du graphique."
msgstr "``Display`` (:class:`~palm_tracer.Settings.Groups.GraphDisplay.GraphDisplay`): graph-rendering options."

#: ../../api/palm_tracer.Settings.Groups.Graph.rst
msgid "Paramètres"
msgstr "Parameters"

#: ../../api/palm_tracer.Settings.Groups.Graph.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.Settings.Groups.Graph.Graph.label:1
msgid "Libellé du groupe affiché dans l'interface."
msgstr "Label of the group displayed in the interface."

#: of palm_tracer.Settings.Groups.Graph.Graph.display:1
msgid "Paramètres d’affichage des graphiques (:class:`~palm_tracer.Settings.Groups.GraphDisplay.GraphDisplay`)."
msgstr "Graph display settings (:class:`~palm_tracer.Settings.Groups.GraphDisplay.GraphDisplay`)."

