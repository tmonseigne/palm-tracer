#: ../../api/palm_tracer.UI.FileMigratorWidget.rst:2
msgid "FileMigratorWidget"
msgstr ""

#: of palm_tracer.UI.FileMigratorWidget:1
msgid "Fournit le widget de migration des anciens résultats Metamorph."
msgstr "Provides the widget for migrating legacy Metamorph results."

#: of palm_tracer.UI.FileMigratorWidget.FileMigratorWidget:1
msgid "Fournit l'interface de migration des anciens dossiers de résultats Metamorph."
msgstr "Provides the interface for migrating legacy Metamorph result folders."

#: ../../api/palm_tracer.UI.FileMigratorWidget.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.UI.FileMigratorWidget.FileMigratorWidget:3
msgid "Widget Qt parent."
msgstr "Parent Qt widget."

#: of palm_tracer.UI.FileMigratorWidget.FileMigratorWidget:4
msgid "Instance partagée, ou :obj:`None` pour en créer une."
msgstr "Shared instance, or :obj:`None` to create one."

#: of palm_tracer.UI.FileMigratorWidget.FileMigratorWidget.UI_NAME:1
msgid "Nom de l'interface de migration."
msgstr "Name of the migration interface."

#: of palm_tracer.UI.FileMigratorWidget.FileMigratorWidget.DROP_MULTIPLE:1
msgid "Limite le dépôt à un dossier de résultats."
msgstr "Limits drops to a single results directory."

#: of palm_tracer.UI.FileMigratorWidget.FileMigratorWidget.DROP_DIRECTORIES:1
msgid "Autorise le dépôt du dossier Metamorph à analyser."
msgstr "Allows dropping the Metamorph directory to analyze."

#: of palm_tracer.UI.FileMigratorWidget.open_migrator:1
msgid "Ouvre la fenêtre de l'outil de migration en mode autonome."
msgstr "Opens the migration tool window in standalone mode."

#: of palm_tracer.UI.FileMigratorWidget.open_migrator:3
msgid "Cette fonction est utilisée par le plugin Napari comme point d'entrée : elle crée un :class:`FileMigratorWidget` et l'affiche dans une fenêtre autonome dont la référence est gérée par la base commune."
msgstr "This function is used as an entry point by the Napari plugin: it creates a :class:`FileMigratorWidget` and displays it in a standalone window whose reference is managed by the common base class."
