#: ../../api/palm_tracer.UI.GraphViewerWidget.rst:2
msgid "GraphViewerWidget"
msgstr ""

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget:1
msgid "Affiche interactivement les graphiques associés aux données PALM."
msgstr "Interactively displays graphs associated with PALM data."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget:3
msgid "Le widget sélectionne une famille de données et une ou deux sources, délègue la construction des figures à :class:`~palm_tracer.Processing.Grapher.Grapher` et permet leur export en HTML, PNG ou PDF."
msgstr "The widget selects a data family and one or two sources, delegates figure construction to :class:`~palm_tracer.Processing.Grapher.Grapher`, and supports export to HTML, PNG, or PDF."

#: ../../api/palm_tracer.UI.GraphViewerWidget.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget:6
msgid "Instance principale dont les données sont visualisées. La référence est conservée sans effectuer de copie."
msgstr "Main instance whose data is displayed. The reference is retained without making a copy."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget:8
msgid "Si QtWebEngine n'est pas disponible, le widget utilise un affichage textuel de remplacement."
msgstr "If QtWebEngine is unavailable, the widget uses a fallback text display."

#: ../../api/palm_tracer.UI.GraphViewerWidget.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.UI_NAME:1
msgid "Nom de l'interface de visualisation des graphiques."
msgstr "Name of the graph-viewer interface."

#: ../../api/palm_tracer.UI.GraphViewerWidget.rst:14
msgid "Méthodes"
msgstr "Methods"

#: ../../api/palm_tracer.UI.GraphViewerWidget.rst:17
msgid "Initialisation"
msgstr "Initialization"

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.closeEvent:1
msgid "Nettoyage de l'UI des paramètres lors de la fermeture de la fenêtre."
msgstr "Clearing the settings UI when the window is closed."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.closeEvent:3
msgid "Événement de fermeture Qt."
msgstr "Qt close event."

#: ../../api/palm_tracer.UI.GraphViewerWidget.rst:22
msgid "Glisser-déposer"
msgstr "Drag and drop"

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.showEvent:1
msgid "Active l'interception dans la fenêtre autonome des graphiques."
msgstr "Enables interception in the standalone graph window."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.showEvent:3
msgid "Événement d'affichage Qt."
msgstr "Qt show event."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.hideEvent:1
msgid "Retire le filtre et restaure l'état des dépôts si la fenêtre Qt existe encore."
msgstr "Removes the filter and restores the drop acceptance state if the Qt window still exists."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.hideEvent:3
msgid "Événement de masquage Qt."
msgstr "Qt hide event."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.eventFilter:1
msgid "Intercepte le dépôt d'une seule pile locale dans la fenêtre des graphiques."
msgstr "Intercepts the drop of a single local stack in the graph window."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.eventFilter:3
msgid "Les dépôts multiples, les dossiers et les fichiers absents sont refusés. Les autres fenêtres et les glissements sans fichier local restent inchangés."
msgstr "Drops containing multiple files, directories, and missing files are rejected. Other windows and drags without a local file remain unaffected."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.eventFilter:6
msgid "Objet Qt destinataire de l'événement."
msgstr "Qt object receiving the event."

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.eventFilter:7
msgid "Événement à filtrer."
msgstr "Event to filter."

#: ../../api/palm_tracer.UI.GraphViewerWidget.rst
msgid "Renvoie"
msgstr "Returns"

#: of palm_tracer.UI.GraphViewerWidget.GraphViewerWidget.eventFilter:8
msgid "``True`` si l'événement est consommé avant son traitement habituel."
msgstr "``True`` if the event is consumed before its usual processing."

#: ../../api/palm_tracer.UI.GraphViewerWidget.rst
msgid "Type renvoyé"
msgstr "Return type"
