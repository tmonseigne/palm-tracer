#: ../../api/palm_tracer.Settings.ROI.rst:2
msgid "ROI"
msgstr ""

#: of palm_tracer.Settings.ROI.ROI:1
msgid "Représente une zone d'intérêt issue d'un calque Napari."
msgstr "Represents a region of interest originating from a Napari layer."

#: ../../api/palm_tracer.Settings.ROI.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.Settings.ROI.ROI:3
msgid "Type géométrique de la zone."
msgstr "Geometric type of the region."

#: of palm_tracer.Settings.ROI.ROI:4
msgid "Coordonnées décrivant sa géométrie."
msgstr "Coordinates describing its geometry."

#: ../../api/palm_tracer.Settings.ROI.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.Settings.ROI.ROI.type:1
msgid "Type de dessin (rectangle, polygone, ellipse)."
msgstr "Shape type (rectangle, polygon, ellipse)."

#: of palm_tracer.Settings.ROI.ROI.data:1
msgid "Liste des points sous forme de tableau NumPy."
msgstr "List of points in the form of a NumPy array."
