msgstr "Connects a button directly rather than the setting itself."

#: of
#: palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.attach_to_form:3
#: palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.connect_button:4
msgid "Nom de l'interface à connecter."
msgstr "Name of the interface to connect."

#: of
#: palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.attach_to_form:4
msgid "Formulaire qui va recevoir le widget."
msgstr "Form that will receive the widget."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.connect:3
#: palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.connect_button:3
msgid "Fonction ou slot à connecter."
msgstr "Function or slot to connect."

#: of
#: palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.connect_button:5
msgid "Numéro de la boîte contenant le bouton."
msgstr "Number of the box containing the button."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.connect:1
msgid "Connecte une fonction ou un slot au signal encapsulé."
msgstr "Connects a function or slot to the encapsulated signal."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.disconnect:1
msgid "Déconnecte `f` si fourni, sinon **tous** les slots. Retourne le nombre de déconnecté."
msgstr "Disconnects `f` if provided, otherwise **all** slots. Returns the number of disconnected slots."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.disconnect:3
msgid "Fonction ou slot à déconnecter."
msgstr "Function or slot to disconnect."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.disconnect:4
msgid "Nombre de slots déconnectés."
msgstr "Number of disconnected slots."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.emit:1
msgid "Émet le signal encapsulé."
msgstr "Emits the encapsulated signal."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.emit:3
msgid "Utilisé pour notifier les parties de l'application abonnées au signal."
msgstr "Used to notify parts of the application subscribed to the signal."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.emit:5
msgid "Valeur à émettre."
msgstr "Value to emit."

#: of
#: palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.signal_blocked:1
msgid "Contexte de blocage des signaux de ce paramètre."
msgstr "Blocking context for signals on this setting."

#: of
#: palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.signal_blocked:3
msgid "Si ``True``, émet la dernière valeur à la fin du blocage. Si ``False``, ignore toutes les émissions reçues pendant le blocage."
msgstr "If ``True``, emits the last value at the end of the block. If ``False``, ignores all emissions received during the block."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.sync:1
msgid "Synchronise ce paramètre avec un autre paramètre."
msgstr "Synchronizes this setting with another setting."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.sync:3
msgid "Quand ce paramètre change, la valeur est propagée vers ``other``."
msgstr "When this setting changes, the value is propagated to ``other``."

#: of palm_tracer.Settings.Types.BaseSettingType.BaseSettingType.sync:5
msgid "Autre paramètre à synchroniser."
msgstr "Other setting to synchronize with."
