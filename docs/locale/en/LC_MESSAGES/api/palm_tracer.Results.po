msgstr "Removes the Qt interface associated with the given name."

#: of palm_tracer.Results.Results.clean_ui:3
msgid "Nom de l'interface dans le dictionnaire."
msgstr "Interface name in the dictionary."

#: of palm_tracer.Results.Results.update_uis:1
