msgid "Méthodes"
msgstr "Methods"

#: ../../api/palm_tracer.Results.rst:22
msgid "Initialisation"
msgstr "Initialization"

#: of palm_tracer.Results.Results.output_name:1
msgid "Construit le chemin d'un fichier de résultat sous la forme ``path / name-timestamp.ext``."
msgstr "Builds the path to a result file in the form ``path / name-timestamp.ext``."

#: ../../api/palm_tracer.Results.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.Results.Results.output_name:3
