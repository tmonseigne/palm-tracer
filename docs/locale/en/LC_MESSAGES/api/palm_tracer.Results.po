#: of palm_tracer.Results.Results:1
msgid "Conserve les résultats des traitements et leurs représentations Qt."
msgstr "Stores processing results and their Qt representations."

#: ../../api/palm_tracer.Results.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.Results.Results.KEYS_TO_FILE:1
msgid "Alias entre les noms de fichiers et les clés dans le dictionnaire de DataFrames."
msgstr "Aliases between file names and keys in the DataFrame dictionary."

#: of palm_tracer.Results.Results.stack_name:1
msgid "Nom du fichier en cours d'analyse."
msgstr "Name of the file currently being analyzed."

#: of palm_tracer.Results.Results.localizations:1
msgid "Localisations actives (:class:`~pandas.DataFrame`)."
msgstr "Active localizations (:class:`~pandas.DataFrame`)."

#: of palm_tracer.Results.Results.beads:1
msgid "Billes détectées (:class:`~pandas.DataFrame`)."
msgstr "Detected beads (:class:`~pandas.DataFrame`)."

#: of palm_tracer.Results.Results.tracks:1
msgid "Trajectoires actives (:class:`~pandas.DataFrame`), éventuellement filtrées et reconnectées."
msgstr "Active tracks (:class:`~pandas.DataFrame`), possibly filtered and reconnected."

#: of palm_tracer.Results.Results.tracks_compute:1
msgid "Calculs actifs sur les trajectoires, éventuellement filtrés (:class:`~pandas.DataFrame`)."
msgstr "Active track computations, possibly filtered (:class:`~pandas.DataFrame`)."

