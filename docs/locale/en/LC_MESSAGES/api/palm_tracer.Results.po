#: palm_tracer.Results.Results.get_localization_key
#: palm_tracer.Results.Results.get_tracks_compute_key
#: palm_tracer.Results.Results.get_tracks_key
msgid "Type renvoyé"
msgstr "Return type"

#: of palm_tracer.Results.Results.output_name_by_key:1
msgid "Construit le chemin d'un fichier de résultat à partir de sa clé."
msgstr "Builds the path to a result file from its key."

#: of palm_tracer.Results.Results.output_name_by_key:3
msgid "Clé du fichier."
msgstr "File key."

#: of palm_tracer.Results.Results.load:1
msgid "Charge les résultats précédemment enregistrés pour une pile et un traitement."
msgstr "Loads previously saved results for a stack and processing run."

#: of palm_tracer.Results.Results.load:3
msgid "Nom de la pile en cours d'analyse."
msgstr "Name of the stack currently being analyzed."

#: of palm_tracer.Results.Results.load:4
msgid "Dossier contenant les fichiers de résultats."
msgstr "Directory containing the result files."

#: of palm_tracer.Results.Results.load:5
msgid "Suffixe identifiant le traitement à charger."
msgstr "Suffix identifying the processing run to load."

#: of palm_tracer.Results.Results.reset:1
msgid "Vide entièrement les DataFrames de résultats."
msgstr "Completely clears the result DataFrames."

#: of palm_tracer.Results.Results.reset_filtered:1
msgid "Vide entièrement les DataFrames de résultats filtrés."
msgstr "Completely clears the filtered result DataFrames."

#: ../../api/palm_tracer.Results.rst:31
msgid "Divers"
msgstr "Miscellaneous"

#: of palm_tracer.Results.Results.get_localization_key:1
msgid "Clé des localisations actives, en privilégiant les variantes filtrées et corrigées."
msgstr "Key for active localizations, prioritizing filtered and corrected variants."

#: of palm_tracer.Results.Results.get_tracks_key:1
msgid "Clé des trajectoires actives, en privilégiant les variantes filtrées et reconnectées."
msgstr "Key for active tracks, prioritizing filtered and reconnected variants."

#: of palm_tracer.Results.Results.get_tracks_compute_key:1
msgid "Clés des calculs sur les trajectoires, en privilégiant leurs variantes filtrées."
msgstr "Keys for track computations, prioritizing their filtered variants."

#: of palm_tracer.Results.Results.get_status:1
msgid "Construit les statuts des différentes catégories de résultats actuellement chargées."
msgstr "Builds the statuses of the result categories currently loaded."

#: of palm_tracer.Results.Results.get_status:3
msgid "Statuts indexés par catégorie de résultat."
msgstr "Statuses indexed by result category."

#: of palm_tracer.Results.Results.get_df_status:1
msgid "Construit le statut d'un résultat à partir de ses versions initiale et filtrée."
msgstr "Builds the status of a result from its initial and filtered versions."

#: of palm_tracer.Results.Results.get_df_status:3
msgid "DataFrame initial."
msgstr "Initial DataFrame."

#: of palm_tracer.Results.Results.get_df_status:4
msgid "DataFrame filtré."
msgstr "Filtered DataFrame."

#: of palm_tracer.Results.Results.get_df_status:5
msgid "Nom du type de données, par exemple ``localizations`` ou ``tracks``."
msgstr "Data type name, for example ``localizations`` or ``tracks``."

#: of palm_tracer.Results.Results.get_df_status:6
msgid "Qualificatif ajouté au statut, par exemple ``Reconnected``."
msgstr "Qualifier added to the status, for example ``Reconnected``."

#: of palm_tracer.Results.Results.get_df_status:7
msgid "Statut accompagné du nombre d'éléments avant et, si nécessaire, après filtrage."
msgstr "Status with the number of elements before and, if applicable, after filtering."

#: ../../api/palm_tracer.Results.rst:40
msgid "Entrées-sorties"
msgstr "Input/output"

#: of palm_tracer.Results.Results.save:1
msgid "Enregistre un résultat dans un fichier CSV."
msgstr "Saves a result to a CSV file."

#: of palm_tracer.Results.Results.save:3
msgid "Clé du résultat à enregistrer."
msgstr "Key of the result to save."

#: of palm_tracer.Results.Results.save:4
#: palm_tracer.Results.Results.save_filtered:3
msgid "Dossier de destination."
msgstr "Destination directory."

#: of palm_tracer.Results.Results.save:5
msgid "Suffixe identifiant le traitement."
msgstr "Suffix identifying the processing run."

#: of palm_tracer.Results.Results.save_filtered:1
msgid "Enregistre tous les résultats filtrés non vides et différents de leur version initiale."
msgstr "Saves all non-empty filtered results that differ from their initial version."

#: of palm_tracer.Results.Results.save_filtered:4
msgid "Suffixe identifiant le traitement ; généré automatiquement lorsqu'il est vide."
msgstr "Suffix identifying the processing run; generated automatically when empty."

