#: palm_tracer.Results.Results.output_name_by_key:4
msgid "Chemin du dossier."
msgstr "Directory path."

#: of palm_tracer.Results.Results.output_name:5
#: palm_tracer.Results.Results.output_name_by_key:5
msgid "Suffixe des fichiers pour un traitement (timestamp au format ``YYYYMMDD_HHMMSS``)."
msgstr "File suffix for a processing run (timestamp in ``YYYYMMDD_HHMMSS`` format)."

#: of palm_tracer.Results.Results.output_name:6
#: palm_tracer.Results.Results.output_name_by_key:6
msgid "Extension du fichier ; valeur par défaut : ``csv``."
msgstr "File extension; default value: ``csv``."

