msgid "Interface"
msgstr ""

#: of palm_tracer.Results.Results.get_ui:1
msgid "Retourne une représentation Qt des résultats, existante ou nouvellement créée."
msgstr "Returns an existing or newly created Qt representation of the results."

#: of palm_tracer.Results.Results.get_ui:3
msgid "Nom identifiant la représentation."
msgstr "Name identifying the representation."

#: of palm_tracer.Results.Results.get_ui:4
msgid "Marges internes de la représentation, en pixels."
msgstr "Internal margins of the representation, in pixels."

#: of palm_tracer.Results.Results.get_ui:5
msgid "Représentation Qt synchronisée avec les résultats."
msgstr "Qt representation synchronized with the results."

#: of palm_tracer.Results.Results.clean_ui:1
