#: ../../api/palm_tracer.Settings.Groups.BaseUIGroup.rst:2
msgid "BaseUIGroup"
msgstr ""

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup:1
msgid "Représente une vue Qt associée à un groupe de paramètres."
msgstr "Base class representing a Qt view associated with a setting."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup:3
msgid "Chaque instance possède ses propres widgets, mais reste synchronisée avec le même modèle afin qu'un groupe puisse être affiché simultanément dans plusieurs interfaces."
msgstr "Each instance owns its widgets but remains synchronized with the same model, allowing a group to be displayed simultaneously in multiple interfaces."

#: ../../api/palm_tracer.Settings.Groups.BaseUIGroup.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup:6
msgid "Nom de la vue."
msgstr "View name."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup:7
msgid "Mode de disposition des paramètres."
msgstr "Settings layout mode."

#: ../../api/palm_tracer.Settings.Groups.BaseUIGroup.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.name:1
msgid "Nom du groupe."
msgstr "Group name."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.mode:1
msgid "Mode utilisé uniquement pour construire l’interface."
msgstr "Mode used only to construct the interface."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.layout:1
msgid "Calque principal (:class:`QFormLayout`)."
msgstr "Main layout (:class:`QFormLayout`)."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.widget:1
msgid "Widget principal du groupe (:class:`QWidget`)."
msgstr "Main widget of the group (:class:`QWidget`)."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.checkbox:1
msgid "Case à cocher pour activer ou non le groupe (:class:`QCheckBox`)."
msgstr "Checkbox to enable or disable the group (:class:`QCheckBox`)."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.body_layout:1
msgid "Calque du corps du groupe (:class:`QFormLayout`)."
msgstr "Group body layout (:class:`QFormLayout`)."

#: ../../api/palm_tracer.Settings.Groups.BaseUIGroup.rst:19
msgid "Méthodes"
msgstr "Methods"

#: ../../api/palm_tracer.Settings.Groups.BaseUIGroup.rst:22
msgid "Gestion de la mise en page"
msgstr "Layout management"

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.attach_to_form:1
msgid "Ajoute l'interface du groupe à un formulaire."
msgstr "Adds the group interface to a form."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.attach_to_form:3
msgid ":class:`QFormLayout` dans lequel va être inséré le paramètre."
msgstr ":class:`QFormLayout` into which the setting will be inserted."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.hide:1
msgid "Cache le groupe de paramètres."
msgstr "Hides the setting group."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.show:1
msgid "Affiche le groupe de paramètres."
msgstr "Displays the setting group."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.active:1
msgid "Affiche ou cache le corps du groupe."
msgstr "Displays or hides the body of the group."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup.active:3
msgid "Statut."
msgstr "Status."
