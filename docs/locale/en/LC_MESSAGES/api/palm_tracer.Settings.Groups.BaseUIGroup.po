#: ../../api/palm_tracer.Settings.Groups.BaseUIGroup.rst:2
msgid "BaseUIGroup"
msgstr ""

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup:1
msgid "Classe de base représentant une vue Qt associée à un paramètre."
msgstr "Base class representing a Qt view associated with a setting."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup:3
msgid "Cette classe encapsule tous les objets Qt nécessaires à l'affichage d'un paramètre dans une interface utilisateur."
msgstr "This class encapsulates all the Qt objects needed to display a setting in a user interface."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup:5
msgid "Elle est conçue pour être instanciée plusieurs fois pour un même paramètre, afin de permettre la duplication d'interface (multi-fenêtres, preview, etc.)."
msgstr "It is designed to be instantiated multiple times for a single setting, to allow for interface duplication (multi-window, preview, etc.)."

#: of palm_tracer.Settings.Groups.BaseUIGroup.BaseUIGroup:7
msgid "Chaque instance est indépendante en termes de widgets Qt, mais synchronisée avec le modèle de données auquel elle est associée."
msgstr "Each instance is independent in terms of Qt widgets, but synchronized with the data model to which it is associated."

