#: ../../api/palm_tracer.Settings.Types.BaseUIType.rst:2
msgid "BaseUIType"
msgstr ""

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType:1
msgid "Représente une vue Qt associée à un paramètre configurable."
msgstr "Base class representing a Qt view associated with a setting."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType:3
msgid "Chaque vue conserve ses propres widgets, sa disposition et sa position éventuelle dans un formulaire."
msgstr "Each view retains its own widgets, layout, and optional position in a form."

#: ../../api/palm_tracer.Settings.Types.BaseUIType.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType:5
msgid "Disposition contenant les widgets du paramètre."
msgstr "Layout containing the setting's widgets."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType:6
msgid "Widgets interactifs synchronisés avec le modèle."
msgstr "Interactive widgets synchronized with the model."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType:7
msgid "Libellé Qt associé au paramètre, s'il existe."
msgstr "Qt label associated with the setting, if any."

#: ../../api/palm_tracer.Settings.Types.BaseUIType.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.layout:1
msgid "Calque principal (:class:`QVBoxLayout` dans la plupart des cas, :class:`QHBoxLayout` pour des cas particuliers)."
msgstr "Main layout (:class:`QVBoxLayout` in most cases, :class:`QHBoxLayout` for special cases)."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.boxes:1
msgid "Objets QT permettant de manipuler le paramètre (:class:`QCheckBox`, :class:`QSpinBox`, :class:`QComboBox`...)."
msgstr "Qt objects used to manipulate the setting (:class:`QCheckBox`, :class:`QSpinBox`, :class:`QComboBox`...)."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.label:1
msgid ":class:`QLabel` contenant le nom du paramètre."
msgstr ":class:`QLabel` containing the setting name."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.form:1
msgid "Formulaire parent dans lequel est le paramètre (utile lors d'un Hide & Seek)."
msgstr "Parent form in which the setting is located (useful during a Hide & Seek)."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.row:1
msgid "Position dans le formulaire parent (utile lors d'un Hide & Seek)."
msgstr "Position within the parent form (useful during Hide & Seek)."

#: ../../api/palm_tracer.Settings.Types.BaseUIType.rst:18
msgid "Méthodes"
msgstr "Methods"

#: ../../api/palm_tracer.Settings.Types.BaseUIType.rst:21
msgid "Gestion de la mise en page"
msgstr "Layout management"

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.attach_to_form:1
msgid "Enregistre le :class:`QFormLayout` et la position dans le formulaire pour permettre un show/hide propre."
msgstr "Registers the :class:`QFormLayout` and the position within the form to enable clean show/hide operations."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.attach_to_form:3
msgid ":class:`QFormLayout` dans lequel va être inséré le paramètre."
msgstr ":class:`QFormLayout` into which the setting will be inserted."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.hide:1
msgid "Cache le paramètre."
msgstr "Hides the setting."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.show:1
msgid "Affiche le paramètre."
msgstr "Shows the setting."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.set_tooltip:1
msgid "Ajoute un tooltip au Label."
msgstr "Adds a tooltip to the Label."

#: of palm_tracer.Settings.Types.BaseUIType.BaseUIType.set_tooltip:3
msgid "Tooltip à ajouter."
msgstr "Tooltip to be added."
