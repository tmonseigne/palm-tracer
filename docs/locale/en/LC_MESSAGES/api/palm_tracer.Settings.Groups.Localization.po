#: ../../api/palm_tracer.Settings.Groups.Localization.rst:2
msgid "Localization"
msgstr ""

#: of palm_tracer.Settings.Groups.Localization.Localization:1
msgid "Classe contenant les paramètres de Localisation :"
msgstr "Class containing the Location settings:"

#: of palm_tracer.Settings.Groups.Localization.Localization:3
msgid "Attributs :"
msgstr "Attributes:"

#: of palm_tracer.Settings.Groups.Localization.Localization:4
msgid "**Preview** (:class:`CheckBox <palm_tracer.Settings.Types.CheckBox.CheckBox>`) : Activation de l'aperçu ou non (par défaut : `False`)."
msgstr "**Preview** (:class:`CheckBox <palm_tracer.Settings.Types.CheckBox.CheckBox>`): Enables or disables the preview (default: `False`)."

#: of palm_tracer.Settings.Groups.Localization.Localization:5
msgid "**Threshold** (:class:`SpinFloat <palm_tracer.Settings.Types.SpinFloat.SpinFloat>`) : Seuil de détection de la localisation en intensité (par défaut : `90`)."
msgstr "**Threshold** (:class:`SpinFloat <palm_tracer.Settings.Types.SpinFloat.SpinFloat>`): Threshold for detecting location based on intensity (default: `90`)."

#: of palm_tracer.Settings.Groups.Localization.Localization:7
msgid "**Auto Threshold** (:class:`Button <palm_tracer.Settings.Types.Button.Button>`) : Bouton pour calculer le seuil automatiquement."
msgstr "** **Auto Threshold** (:class:`Button <palm_tracer.Settings.Types.Button.Button>`) : Button to calculate the threshold automatically."

#: of palm_tracer.Settings.Groups.Localization.Localization:8
msgid "**ROI Shape** (:class:`Combo <palm_tracer.Settings.Types.Combo.Combo>`) : Forme de la zone autour de la localisation (par défaut : `Circle`)."
msgstr "**ROI Shape** (:class:`Combo <palm_tracer.Settings.Types.Combo.Combo>`): Shape of the area around the location (default: `Circle`)."

#: of palm_tracer.Settings.Groups.Localization.Localization:9
msgid "**ROI Size** (:class:`SpinInt <palm_tracer.Settings.Types.SpinInt.SpinInt>`) : Taille de la zone autour des localisations (par défaut : `7`)."
msgstr "**ROI Size** (:class:`SpinInt <palm_tracer.Settings.Types.SpinInt.SpinInt>`): Size of the area around the locations (default: `7`)."

#: of palm_tracer.Settings.Groups.Localization.Localization:10
msgid "**Watershed** (:class:`CheckBox <palm_tracer.Settings.Types.CheckBox.CheckBox>`) : Activation ou désactivation du mode Watershed (par défaut : `True`)."
msgstr "**Watershed** (:class:`CheckBox <palm_tracer.Settings.Types.CheckBox.CheckBox>`): Enables or disables Watershed mode (default: `True`)."

#: of palm_tracer.Settings.Groups.Localization.Localization:12
msgid "**Fit** (:class:`Combo <palm_tracer.Settings.Types.Combo.Combo>`) : Mode de calcul d'ajustement pour la localisation (par défaut : `Nothing`)."
msgstr "**Fit** (:class:`Combo <palm_tracer.Settings.Types.Combo.Combo>`): Fit calculation mode for the location (default: `Nothing`)."

#: of palm_tracer.Settings.Groups.Localization.Localization:13
msgid "**Gaussian Fit** (:class:`GaussianFit <palm_tracer.Settings.Groups.GaussianFit.GaussianFit>`) : Paramètres du Gaussian Fit."
msgstr "**Gaussian Fit** (:class:`GaussianFit <palm_tracer.Settings.Groups.GaussianFit.GaussianFit>`): Gaussian Fit parameters."

#: of palm_tracer.Settings.Groups.Localization.Localization:14
msgid "**Spline Fit** (:class:`SplineFit <palm_tracer.Settings.Groups.SplineFit.SplineFit>`) : Paramètres du Spline Fit."
msgstr "**Spline Fit** (:class:`SplineFit <palm_tracer.Settings.Groups.SplineFit.SplineFit>`): Spline Fit parameters."

