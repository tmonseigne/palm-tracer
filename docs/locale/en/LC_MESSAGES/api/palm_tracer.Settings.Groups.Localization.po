msgstr "-1: Group default value"

#: of palm_tracer.Settings.Groups.Localization.Localization.get_ui:7
msgid "0 : Avec un titre et une checkbox pour activer/désactiver le groupe"
msgstr "0: With a title and a checkbox to enable/disable the group"

#: of palm_tracer.Settings.Groups.Localization.Localization.get_ui:8
msgid "1 : État lorsque l'on utilise la méthode always actif (la check box n'est pas créé)"
msgstr "1: State when using the \"always active\" method (the checkbox is not created)"

#: of palm_tracer.Settings.Groups.Localization.Localization.get_ui:9
msgid "2 : État remove header (aucune création de l'espace titre)"
msgstr "2: \"Remove header\" state (no title area created)"

