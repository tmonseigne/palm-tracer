#: of palm_tracer.Settings.Groups.Localization.Localization.get_ui:4
msgid "Méthode de création du groupe.  - -1 : Valeur par défaut du groupe - 0 : Avec un titre et une checkbox pour activer/désactiver le groupe - 1 : État lorsque l'on utilise la méthode always actif (la check box n'est pas créé) - 2 : État remove header (aucune création de l'espace titre)"
msgstr "Group creation method.  - -1: Group default value - 0: With a title and a checkbox to enable/disable the group - 1: State when using the \"always active\" method (the checkbox is not created) - 2: \"Remove header\" state (no title area created)"

#: of palm_tracer.Settings.Groups.Localization.Localization.get_ui:4
msgid "Méthode de création du groupe."
msgstr "Group creation method."

#: of palm_tracer.Settings.Groups.Localization.Localization.get_ui:6
