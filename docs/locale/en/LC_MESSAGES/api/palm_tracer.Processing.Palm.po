#: of palm_tracer.Processing.Palm.Palm.max_allocation_bytes:1
msgid "Permet de calculer la quantité de mémoire disponible au maximum pour une allocation."
msgstr "Allows you to calculate the maximum amount of memory available for allocation."

#: ../../api/palm_tracer.Processing.Palm.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.Processing.Palm.Palm.max_allocation_bytes:3
msgid "Pourcentage de la RAM disponible à utiliser au maximum."
msgstr "Percentage of available RAM to use at most."

#: of palm_tracer.Processing.Palm.Palm.max_allocation_bytes:4
msgid "Marge de sécurité à garder disponible."
msgstr "Safety margin to keep available."

#: of palm_tracer.Processing.Palm.Palm.max_allocation_bytes:5
msgid "Valeur en byte de l'allocation maximum tolérée."
msgstr "Value in bytes of the maximum allowed allocation."

