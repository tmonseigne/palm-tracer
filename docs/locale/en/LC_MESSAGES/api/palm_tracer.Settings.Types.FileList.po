#: ../../api/palm_tracer.Settings.Types.FileList.rst:2
msgid "FileList"
msgstr ""

#: of palm_tracer.Settings.Types.FileList.FileList:1
msgid "Représente un paramètre contenant une liste de fichiers et une sélection active."
msgstr "Represents a setting containing a list of files and an active selection."

#: ../../api/palm_tracer.Settings.Types.FileList.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.Settings.Types.FileList.FileList:3
msgid "Libellé affiché dans l'interface."
msgstr "Label displayed in the interface."

#: of palm_tracer.Settings.Types.FileList.FileList:4
msgid "Description affichée dans l'infobulle."
msgstr "Description displayed in the tooltip."

#: of palm_tracer.Settings.Types.FileList.FileList:5
msgid "Extensions autorisées en minuscules, ou tuple vide pour accepter tous les fichiers."
msgstr "Allowed extensions in lowercase, or an empty tuple to accept all files."

#: of palm_tracer.Settings.Types.FileList.FileList:6
msgid "Filtre affiché par le sélecteur de fichiers."
msgstr "Filter displayed by the file selection dialog."

#: ../../api/palm_tracer.Settings.Types.FileList.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.Settings.Types.FileList.FileList.extensions:1
msgid "Extensions acceptées à l'ajout ; un tuple vide ne limite pas les extensions."
msgstr "Extensions accepted when adding files; an empty tuple allows all extensions."

#: of palm_tracer.Settings.Types.FileList.FileList.file_filter:1
msgid "Filtre du sélecteur, cohérent avec les extensions autorisées."
msgstr "Dialog filter matching the allowed extensions."

#: of palm_tracer.Settings.Types.FileList.FileList.default:1
msgid "Valeur (position dans la liste) par défaut du paramètre (:class:`int`)."
msgstr "Default value (position in the list) of the setting (:class:`int`)."

#: of palm_tracer.Settings.Types.FileList.FileList.value:1
msgid "Valeur actuelle du paramètre (position dans la liste en :class:`int`)."
msgstr "Current value of the setting (position in the list as :class:`int`)"

#: of palm_tracer.Settings.Types.FileList.FileList.current_text:1
msgid "Valeur actuelle du paramètre (élément dans la liste en :class:`str`)."
msgstr "Current value of the setting (element in the list as :class:`str`)"

#: of palm_tracer.Settings.Types.FileList.FileList.items:1
msgid "Récupère la liste des éléments."
msgstr "Retrieves the list of elements."

#: ../../api/palm_tracer.Settings.Types.FileList.rst:19
msgid "Méthodes"
msgstr "Methods"

#: ../../api/palm_tracer.Settings.Types.FileList.rst:22
msgid "Divers"
msgstr "Miscellaneous"

#: of palm_tracer.Settings.Types.FileList.FileList.reset:1
msgid "Vide la liste de fichiers et réinitialise la sélection."
msgstr "Clears the file list and resets the selection."

#: ../../api/palm_tracer.Settings.Types.FileList.rst:27
msgid "Accesseurs"
msgstr "Accessors"

#: of palm_tracer.Settings.Types.FileList.FileList.get_ui:1
msgid "Renvoie une interface (:class:`~palm_tracer.Settings.Types.BaseUIType.BaseUIType`) existante ou en crée une si nécessaire."
msgstr "Returns an existing (:class:`~palm_tracer.Settings.Types.BaseUIType.BaseUIType`) object, or creates one if necessary."

#: of palm_tracer.Settings.Types.FileList.FileList.get_ui:3
msgid "Nom de l'interface dans le dictionnaire."
msgstr "Interface name in the dictionary."

#: ../../api/palm_tracer.Settings.Types.FileList.rst
msgid "Renvoie"
msgstr "Returns"

#: of palm_tracer.Settings.Types.FileList.FileList.get_ui:4
msgid "Interface du paramètre (:class:`~palm_tracer.Settings.Types.BaseUIType.BaseUIType`)."
msgstr "Setting interface (:class:`~palm_tracer.Settings.Types.BaseUIType.BaseUIType`)."

#: ../../api/palm_tracer.Settings.Types.FileList.rst of
#: palm_tracer.Settings.Types.FileList.FileList.to_compact_dict
msgid "Type renvoyé"
msgstr "Return type"

#: ../../api/palm_tracer.Settings.Types.FileList.rst:32
msgid "Sérialisation"
msgstr "Serialization"

#: of palm_tracer.Settings.Types.FileList.FileList.to_compact_dict:1
msgid "Renvoie l'indice sélectionné et la liste des fichiers pour la sauvegarde compacte."
msgstr "Returns the selected index and file list for compact storage."

#: of palm_tracer.Settings.Types.FileList.FileList.update_from_compact_dict:1
msgid "Restaure les fichiers avant l'indice sélectionné depuis une sauvegarde compacte."
msgstr "Restores the files before the selected index from compact storage."

#: of palm_tracer.Settings.Types.FileList.FileList.update_from_compact_dict:3
msgid "Dictionnaire contenant les clés ``items`` et ``value``."
msgstr "Dictionary containing the ``items`` and ``value`` keys."

#: ../../api/palm_tracer.Settings.Types.FileList.rst:38
msgid "Fonctions de rappel"
msgstr "Callbacks"

#: of palm_tracer.Settings.Types.FileList.FileList.add_file:1
msgid "Ajoute des fichiers à la liste via un :class:`QFileDialog`."
msgstr "Adds one or more files to the list using a :class:`QFileDialog`."

#: of palm_tracer.Settings.Types.FileList.FileList.add_files:1
msgid "Ajoute les fichiers existants en triant uniquement le nouveau lot."
msgstr "Adds existing files, sorting only the new batch."

#: of palm_tracer.Settings.Types.FileList.FileList.add_files:3
msgid "Les dossiers, chemins inexistants et extensions non autorisées sont ignorés. Les doublons sont conservés, comme lors de l'ajout par la boîte de dialogue. Le dernier fichier ajouté est sélectionné et les interfaces sont synchronisées avec une seule notification."
msgstr "Directories, nonexistent paths, and disallowed extensions are ignored. Duplicates are retained, as when adding files through the dialog. The last added file is selected, and the interfaces are synchronized with a single notification."

#: of palm_tracer.Settings.Types.FileList.FileList.add_files:7
msgid "Chemins locaux des fichiers à ajouter."
msgstr "Local paths of the files to add."

#: of palm_tracer.Settings.Types.FileList.FileList.remove_file:1
msgid "Supprime le fichier actuellement sélectionné dans la :class:`QComboBox`."
msgstr "Removes the file currently selected in the :class:`QComboBox`."

#: of palm_tracer.Settings.Types.FileList.FileList.clear_files:1
msgid "Vide la liste des fichiers."
msgstr "Clears the list of files."
