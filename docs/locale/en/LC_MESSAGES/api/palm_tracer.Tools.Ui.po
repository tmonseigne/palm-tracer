msgstr "Internal spacing between elements (in pixels)."

#: of palm_tracer.Tools.Ui.make_info_grid:19
msgid "Marges du layout (en pixels)."
msgstr "Layout margins (in pixels)."

#: of palm_tracer.Tools.Ui.make_info_grid:20
msgid "Le :class:`QGridLayout` configuré."
msgstr "The configured :class:`QGridLayout`."

