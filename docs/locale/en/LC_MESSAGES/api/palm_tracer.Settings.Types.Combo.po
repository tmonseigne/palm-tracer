msgid "Combo"
msgstr ""

#: of palm_tracer.Settings.Types.Combo.Combo:1
msgid "Représente un choix effectué dans une liste déroulante. Seul l'indice sélectionné est sérialisé ; les choix sont définis par le code ou reconstruits par le groupe de paramètres."
msgstr "Represents a selection in a drop-down list. Only the selected index is serialized; the choices are defined in the code or rebuilt by the parameter group."

#: ../../api/palm_tracer.Settings.Types.Combo.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.Settings.Types.Combo.Combo:4
msgid "Libellé affiché dans l'interface."
msgstr "Label displayed in the interface."

#: of palm_tracer.Settings.Types.Combo.Combo:5
msgid "Description affichée dans l'infobulle."
msgstr "Description displayed in the tooltip."

#: of palm_tracer.Settings.Types.Combo.Combo:6
msgid "Indice sélectionné par défaut."
msgstr "Index selected by default."

#: of palm_tracer.Settings.Types.Combo.Combo:7
msgid "Libellés des choix proposés."
msgstr "Labels of the available choices."

