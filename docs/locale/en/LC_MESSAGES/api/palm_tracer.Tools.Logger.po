#: of palm_tracer.Tools.Logger.Logger:1
msgid "Classe du journal d'activité."
msgstr "Activity log class."

#: of palm_tracer.Tools.Logger.Logger:4
msgid "Notes"
msgstr ""

#: of palm_tracer.Tools.Logger.Logger:5
msgid "L'ouverture est idempotente : si un fichier est déjà ouvert, il est fermé avant de rouvrir."
msgstr "Opening is idempotent: if a file is already open, it is closed before being reopened."

#: of palm_tracer.Tools.Logger.Logger:6
msgid "La fermeture est idempotente : `close()` peut être appelée plusieurs fois sans erreurs."
msgstr "Closing is idempotent: `close()` can be called multiple times without errors."

#: of palm_tracer.Tools.Logger.Logger:7
msgid "La classe implémente le protocole context manager pour garantir la fermeture."
msgstr "The class implements the context manager protocol to ensure the file is closed."

#: ../../api/palm_tracer.Tools.Logger.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.Tools.Logger.Logger.filename:1
msgid "Chemin du fichier de log ouvert (vide si aucun)."
msgstr "Path to the open log file (empty if none)."

#: of palm_tracer.Tools.Logger.Logger.file_handle:1
msgid "Handle du fichier ouvert (``None`` si fermé)."
msgstr "Handle to the open file (``None`` if closed)."

#: ../../api/palm_tracer.Tools.Logger.rst:15
msgid "Méthodes"
msgstr "Methods"

#: ../../api/palm_tracer.Tools.Logger.rst:18
msgid "Divers"
msgstr "Miscellaneous"

#: of palm_tracer.Tools.Logger.Logger.open:1
msgid "Ouvre le fichier de log en mode ajout."
msgstr "Opens the log file in append mode."

#: ../../api/palm_tracer.Tools.Logger.rst of
#: palm_tracer.Tools.Logger.Logger.add
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.Tools.Logger.Logger.open:3
msgid "Chemin du fichier de log."
msgstr "Path to the log file."

#: of palm_tracer.Tools.Logger.Logger.open:5
msgid "Si un fichier était déjà ouvert, il est fermé avant la réouverture afin d'éviter les handles orphelins (particulièrement problématiques sous Windows)."
msgstr "If a file was already open, it is closed before reopening to avoid orphaned handles (particularly problematic on Windows)."

#: of palm_tracer.Tools.Logger.Logger.close:1
msgid "Ferme le fichier de log."
msgstr "Closes the log file."

#: of palm_tracer.Tools.Logger.Logger.close:3
msgid "Méthode idempotente : peut être appelée plusieurs fois. Force un flush + fsync pour limiter les surprises d'I/O (notamment sous Windows)."
msgstr "Idempotent method: can be called multiple times. Forces a flush + fsync to limit I/O surprises (especially on Windows)."

#: of palm_tracer.Tools.Logger.Logger.add:1
msgid "Ajoute un message au log."
msgstr "Adds a message to the log."
