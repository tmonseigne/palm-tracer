#: ../../api/palm_tracer.UI.ResultsUI.rst:2
msgid "ResultsUI"
msgstr ""

#: of palm_tracer.UI.ResultsUI.ResultsUI:1
msgid "Représente une vue Qt des résultats de PALMTracer avec des boutons de suppression."
msgstr "Represents a Qt view of PALMTracer results with clear buttons."

#: of palm_tracer.UI.ResultsUI.ResultsUI:3
msgid "La vue ne conserve aucune donnée métier. Elle affiche les statuts transmis par :class:`~palm_tracer.Results.Results` et peut ainsi être synchronisée avec les autres représentations du même modèle."
msgstr "The view does not store any domain data. It displays the statuses provided by :class:`~palm_tracer.Results.Results` and can therefore be synchronized with other representations of the same model."

#: ../../api/palm_tracer.UI.ResultsUI.rst
msgid "Paramètres"
msgstr "Parameters"

#: of palm_tracer.UI.ResultsUI.ResultsUI:6
#: palm_tracer.UI.ResultsUI.ResultsUI.title:1
msgid "Titre du groupe d'informations."
msgstr "Title of the information group."

#: of palm_tracer.UI.ResultsUI.ResultsUI:7
msgid "Espacement interne entre les éléments, en pixels."
msgstr "Internal spacing between elements, in pixels."

#: of palm_tracer.UI.ResultsUI.ResultsUI:8
#: palm_tracer.UI.ResultsUI.ResultsUI.margin:1
msgid "Marges internes du groupe, en pixels."
msgstr "Internal margins of the group, in pixels."

#: ../../api/palm_tracer.UI.ResultsUI.rst:9
msgid "Attributs"
msgstr "Attributes"

#: of palm_tracer.UI.ResultsUI.ResultsUI.space:1
msgid "Espacement entre les lignes, en pixels."
msgstr "Spacing between rows, in pixels."

#: of palm_tracer.UI.ResultsUI.ResultsUI.widget:1
msgid "Widget contenant les informations sur les résultats."
msgstr "Widget containing the result information."

#: of palm_tracer.UI.ResultsUI.ResultsUI.layout:1
msgid "Calque contenant les différentes lignes d'informations."
msgstr "Layout containing the different information rows."

#: of palm_tracer.UI.ResultsUI.ResultsUI.labels:1
msgid "Libellés affichant les statuts des résultats."
msgstr "Labels displaying the status of the results."

#: of palm_tracer.UI.ResultsUI.ResultsUI.clear_buttons:1
msgid "Corbeilles par catégorie."
msgstr "Trash bins by category."

#: of palm_tracer.UI.ResultsUI.ResultsUI.open_folder_button:1
msgid "Bouton d'ouverture du dossier de résultats."
msgstr "Button to open the results folder."

#: ../../api/palm_tracer.UI.ResultsUI.rst:21
msgid "Méthodes"
msgstr "Methods"

#: ../../api/palm_tracer.UI.ResultsUI.rst:24
msgid "Mise à jour"
msgstr "Update"

#: of palm_tracer.UI.ResultsUI.ResultsUI.update_status:1
msgid "Actualise les statuts affichés."
msgstr "Updates the displayed statuses."

#: of palm_tracer.UI.ResultsUI.ResultsUI.update_status:3
msgid "Les clés inconnues sont ignorées afin de permettre au modèle de fournir des informations qui ne sont pas représentées par cette vue."
msgstr "Unknown keys are ignored, allowing the model to provide information that is not represented by this view."

#: of palm_tracer.UI.ResultsUI.ResultsUI.update_status:6
msgid "Statuts à afficher, indexés par type de résultat."
msgstr "Statuses to display, indexed by result type."

#: of palm_tracer.UI.ResultsUI.ResultsUI.update_results_folder:1
msgid "Actualise la disponibilité du bouton et son infobulle."
msgstr "Updates the button's availability and tooltip."

#: of palm_tracer.UI.ResultsUI.ResultsUI.update_results_folder:3
msgid "Dossier des résultats, ou :obj:`None` si aucun dossier n'est associé."
msgstr "Results directory, or :obj:`None` if no directory is associated."
