msgid "Ce diagramme présente les types de paramètres réutilisables et leur hiérarchie."
msgstr "This diagram shows the reusable setting types and their hierarchy."

#: ../../diagram.rst:51
msgid "Diagramme des types de paramètres PALM Tracer"
msgstr "PALM Tracer Setting Types Diagram"
