#: ../../diagram.rst:2
msgid "Diagrammes de classes de PALM Tracer"
msgstr "PALM Tracer Class Diagrams"

#: ../../diagram.rst:4
msgid "Ces diagrammes présentent les principales classes et leurs relations. Les attributs et les méthodes sont volontairement masqués afin de privilégier une vue synthétique de l'architecture."
msgstr "These diagrams present the main classes and their relationships. Attributes and methods are intentionally hidden to provide a concise overview of the architecture."

#: ../../diagram.rst:10
msgid "Cœur applicatif"
msgstr "Application Core"

#: ../../diagram.rst:12
msgid "Ce diagramme regroupe l'orchestration, les traitements, les résultats, la configuration et les outils de PALM Tracer."
msgstr "This diagram covers PALM Tracer's orchestration, processing, results, configuration, and tools."

#: ../../diagram.rst:15
msgid "Diagramme du cœur applicatif de PALM Tracer"
msgstr "PALM Tracer Application Core Diagram"

#: ../../diagram.rst:22
msgid "Interface graphique"
msgstr "Graphical User Interface"

#: ../../diagram.rst:24
msgid "Ce diagramme présente les classes du paquet ``palm_tracer.UI``, dont les widgets Napari et les vues de résultats."
msgstr "This diagram shows the classes in the ``palm_tracer.UI`` package, including Napari widgets and result views."

#: ../../diagram.rst:27
msgid "Diagramme de l'interface graphique de PALM Tracer"
msgstr "PALM Tracer Graphical User Interface Diagram"

#: ../../diagram.rst:34
msgid "Groupes de paramètres"
msgstr "Setting Groups"

#: ../../diagram.rst:36
msgid "Ce diagramme présente la hiérarchie des groupes qui structurent la configuration des différentes étapes du traitement."
msgstr "This diagram shows the hierarchy of setting groups used to configure the processing steps."

#: ../../diagram.rst:39
msgid "Diagramme des groupes de paramètres PALM Tracer"
msgstr "PALM Tracer Setting Groups Diagram"

#: ../../diagram.rst:46
msgid "Types de paramètres"
