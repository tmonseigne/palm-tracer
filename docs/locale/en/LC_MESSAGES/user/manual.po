#: ../../user/manual.rst:2
msgid "Manuel d'utilisation"
msgstr "User manual"

#: ../../user/manual.rst:9
msgid "PALM Tracer est un plugin Napari pour localiser des émetteurs, suivre des particules et explorer les résultats d'une acquisition."
msgstr "PALM Tracer is a Napari plugin for localizing emitters, tracking particles, and exploring acquisition results."

#: ../../user/manual.rst:12
msgid "Lancement"
msgstr "Launch"

#: ../../user/manual.rst:14
msgid "Pour lancer Napari et ouvrir le widget principal, suivez les instructions de :ref:`lancement de PALM Tracer <launch_palmtracer>`."
msgstr "To start Napari and open the main widget, follow the instructions for :ref:`launching PALM Tracer <launch_palmtracer>`."

#: ../../user/manual.rst:18
msgid "Organisation de l'interface"
msgstr "Interface organization"

#: ../../user/manual.rst:20
msgid "L'interface Napari avec PALMTracer est organisée en trois volets principaux :"
msgstr "The Napari interface with PALMTracer is organized into three main sections:"

#: ../../user/manual.rst:22
msgid "À gauche : le panneau des calques (Layers)"
msgstr "On the left: the layers panel (Layers)"

#: ../../user/manual.rst:23
msgid "Au centre : la fenêtre de visualisation"
msgstr "In the center: the visualization window"

#: ../../user/manual.rst:24
msgid "À droite : le widget PALMTracer"
msgstr "On the right: the PALMTracer widget"

#: ../../user/manual.rst:26 ../../user/manual.rst:33
msgid "Vue d'ensemble de Napari avec le widget PALMTracer"
msgstr "Overview of Napari with the PALMTracer widget"

#: ../../user/manual.rst:37
msgid "Volet des calques"
msgstr "Layers panel"

#: ../../user/manual.rst:39
msgid "Le volet des calques permet de retrouver les éléments affichés par le widget."
msgstr "The layers panel lists the items displayed by the widget."

#: ../../user/manual.rst:41
msgid ":guilabel:`Raw` contient l'image brute."
msgstr ":guilabel:`Raw` contains the raw image."

#: ../../user/manual.rst:42
msgid ":guilabel:`Points Past`, :guilabel:`Points Present` et :guilabel:`Points Future` montrent les détections retenues dans l'aperçu sur les trois plans."
msgstr ":guilabel:`Points Past`, :guilabel:`Points Present` and :guilabel:`Points Future` show the detections retained in the preview across the three frames."

#: ../../user/manual.rst:43
msgid ":guilabel:`Points Filtered` montre les détections écartées sur le plan courant."
msgstr ":guilabel:`Points Filtered` shows the detections rejected in the current frame."

#: ../../user/manual.rst:44
msgid ":guilabel:`ROI Present` trace les contours des fenêtres autour des détections retenues sur le plan courant."
msgstr ":guilabel:`ROI Present` outlines the windows around the retained detections in the current frame."

#: ../../user/manual.rst:45
msgid ":guilabel:`ROI Filter` contient les :term:`zones d'intérêt <ROI (Region Of Interest)>` dessinées pour le filtrage."
msgstr ":guilabel:`ROI Filter` contains the :term:`regions of interest <ROI (Region Of Interest)>` drawn for filtering."

