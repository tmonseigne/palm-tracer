"palm_tracer.UI.ViewerHRWidget.ViewerHRWidget" -> "palm_tracer.UI.BaseNapariWidget.BaseNapariWidget" [arrowhead="empty", arrowtail="none", minlen="1"];

// Contraintes invisibles limitant la largeur des classes isolées.
"palm_tracer.UI.NotificationWidget.NotificationWidget" -> "palm_tracer.UI.ResultsUI.ResultsUI" [style="invis"];
