digraph "classes_ui" {
graph [bgcolor="transparent", nodesep="0.35", pad="0.2", rankdir="BT", ranksep="0.7"];
node [color="#4a4a4a", fillcolor="#ace6ac", fontcolor="black", fontname="Helvetica", fontsize="10", shape="box", style="filled,rounded"];
edge [color="#666666", fontcolor="#006400", fontname="Helvetica", fontsize="9"];

"palm_tracer.UI.AlignmentWidget.AlignmentWidget" [label="AlignmentWidget"];
"palm_tracer.UI.Astigmatism3DWidget.Astigmatism3DWidget" [label="Astigmatism3DWidget"];
