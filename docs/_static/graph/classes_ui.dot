"palm_tracer.UI.BaseWidget.BaseWidget" [label="BaseWidget"];
"palm_tracer.UI.FileMigratorWidget.FileMigratorWidget" [label="FileMigratorWidget"];
"palm_tracer.UI.GraphViewerWidget.GraphViewerWidget" [label="GraphViewerWidget"];
