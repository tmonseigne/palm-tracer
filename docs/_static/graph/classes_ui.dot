"palm_tracer.UI.PALMTracerWidget.PALMTracerWidget" [label="PALMTracerWidget"];
"palm_tracer.UI.ResultsUI.ResultsUI" [label="ResultsUI"];
"palm_tracer.UI.Viewer3DWidget.Viewer3DWidget" [label="Viewer3DWidget"];
