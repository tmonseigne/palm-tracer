"palm_tracer.UI.AlignmentWidget.AlignmentWidget" -> "palm_tracer.UI.BaseWidget.BaseWidget" [arrowhead="empty", arrowtail="none", minlen="1"];
"palm_tracer.UI.Astigmatism3DWidget.Astigmatism3DWidget" -> "palm_tracer.UI.BasePlotlyWidget.BasePlotlyWidget" [arrowhead="empty", arrowtail="none", minlen="1"];
"palm_tracer.UI.BaseNapariWidget.BaseNapariWidget" -> "palm_tracer.UI.BaseWidget.BaseWidget" [arrowhead="empty", arrowtail="none", minlen="1"];
"palm_tracer.UI.BasePlotlyWidget.BasePlotlyWidget" -> "palm_tracer.UI.BaseWidget.BaseWidget" [arrowhead="empty", arrowtail="none", minlen="1"];
"palm_tracer.UI.FileMigratorWidget.FileMigratorWidget" -> "palm_tracer.UI.BaseWidget.BaseWidget" [arrowhead="empty", arrowtail="none", minlen="1"];
"palm_tracer.UI.GraphViewerWidget.GraphViewerWidget" -> "palm_tracer.UI.BasePlotlyWidget.BasePlotlyWidget" [arrowhead="empty", arrowtail="none", minlen="1"];
"palm_tracer.UI.GraphViewerWidget.GraphViewerWidget" -> "palm_tracer.UI.PALMTracerWidget.PALMTracerWidget" [arrowhead="odiamond", arrowtail="none", fontcolor="#006400", label="viewer_graph", minlen="1"];
