"palm_tracer.UI.PALMTracerWidget.PALMTracerWidget" -> "palm_tracer.UI.ViewerHRWidget.ViewerHRWidget" [arrowhead="vee", arrowtail="none", fontcolor="#006400", label="viewer_hr_widget", minlen="1"];
